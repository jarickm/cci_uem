rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jmmontojo2019@gmail.com' ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Organizations
    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(orgId) && isSignedIn() && incoming().keys().hasAll(['id', 'name']) && incoming().name.size() <= 100;
      allow update: if isValidId(orgId) && isSignedIn() && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'primaryContact', 'settings', 'updatedAt']));
      allow delete: if isValidId(orgId) && isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isValidId(userId) && isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Enrolled Devices Inventory
    match /devices/{deviceId} {
      allow get: if isValidId(deviceId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(deviceId) && isSignedIn() && incoming().keys().hasAll(['id', 'orgId', 'hostname', 'platform', 'status']);
      allow update: if isValidId(deviceId) && isSignedIn();
      allow delete: if isValidId(deviceId) && isAdmin();
    }

    // Enrollment Tokens
    match /enrollmentTokens/{tokenId} {
      allow get: if isValidId(tokenId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(tokenId) && isSignedIn();
      allow update: if isValidId(tokenId) && isSignedIn();
      allow delete: if isValidId(tokenId) && isAdmin();
    }

    // Device Groups
    match /deviceGroups/{groupId} {
      allow get: if isValidId(groupId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(groupId) && isSignedIn();
      allow update: if isValidId(groupId) && isSignedIn();
      allow delete: if isValidId(groupId) && isAdmin();
    }

    // Policies
    match /policies/{policyId} {
      allow get: if isValidId(policyId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(policyId) && isSignedIn();
      allow update: if isValidId(policyId) && isSignedIn();
      allow delete: if isValidId(policyId) && isAdmin();
    }

    // Applications & Packages
    match /applications/{packageId} {
      allow get: if isValidId(packageId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(packageId) && isSignedIn();
      allow update: if isValidId(packageId) && isSignedIn();
      allow delete: if isValidId(packageId) && isAdmin();
    }

    // Curated Verified Software Catalog
    match /verifiedSoftware/{softwareId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Geofences
    match /geofences/{geofenceId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Deployments
    match /deployments/{deploymentId} {
      allow get: if isValidId(deploymentId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(deploymentId) && isSignedIn();
      allow update: if isValidId(deploymentId) && isSignedIn();
      allow delete: if isValidId(deploymentId) && isAdmin();
    }

    // Commands Queue
    match /commands/{commandId} {
      allow get: if isValidId(commandId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(commandId) && isSignedIn();
      allow update: if isValidId(commandId) && isSignedIn();
      allow delete: if isValidId(commandId) && isAdmin();
    }

    // Compliance Rules
    match /complianceRules/{ruleId} {
      allow get: if isValidId(ruleId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(ruleId) && isSignedIn();
      allow update: if isValidId(ruleId) && isSignedIn();
      allow delete: if isValidId(ruleId) && isAdmin();
    }

    // Security Alerts
    match /securityAlerts/{alertId} {
      allow get: if isValidId(alertId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(alertId) && isSignedIn();
      allow update: if isValidId(alertId) && isSignedIn();
      allow delete: if isValidId(alertId) && isAdmin();
    }

    // Automations
    match /automations/{automationId} {
      allow get: if isValidId(automationId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(automationId) && isSignedIn();
      allow update: if isValidId(automationId) && isSignedIn();
      allow delete: if isValidId(automationId) && isAdmin();
    }

    // Audit Events (Append-only by authenticated users, immutable, read-only for auditors/admins)
    match /auditEvents/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(eventId) && isSignedIn() && incoming().keys().hasAll(['id', 'orgId', 'actorEmail', 'action', 'timestamp']);
      allow update, delete: if false; // Strict immutability for audit records
    }

    // System Settings
    match /systemSettings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
